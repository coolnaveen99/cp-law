{
  "name": "cp-law",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Codepackr Law Architecture Split — content platform (code in Git, corpus outside Git)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "test": "tsx --test tests/repository.test.ts",
    "export:fixtures": "tsx scripts/export-to-supabase.ts --from fixtures --publish",
    "export:law": "tsx scripts/export-to-supabase.ts --from codepackr-law --publish",
    "export:law:dry": "tsx scripts/export-to-supabase.ts --from codepackr-law --dry-run",
    "case:init": "tsx scripts/ingest-case.ts --init",
    "case:ingest": "tsx scripts/ingest-case.ts --file",
    "staging:ingest": "tsx scripts/ingest-case.ts --dir staging --publish",
    "staging:dry": "tsx scripts/ingest-case.ts --dir staging --dry-run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
